# --- Public funnel (agnes-next, build-time NEXT_PUBLIC_*) ---
# Lightning routes to /contest only (default). Set false to restore protocol/terminal split.
# NEXT_PUBLIC_ENTRY_FUNNEL_CONTEST_ONLY=false

# Weighted split when contest-only is false (defaults: 20 / 40 / 40).
# Production simplified funnel:
# NEXT_PUBLIC_ENTRY_SPLIT_TERMINAL=0
# NEXT_PUBLIC_ENTRY_SPLIT_PROTOCOL=0
# NEXT_PUBLIC_ENTRY_SPLIT_CONTEST=100

# Staging QA: honor ?v=protocol|terminal when contest-only is on.
# NEXT_PUBLIC_ENTRY_FUNNEL_ALLOW_OVERRIDES=true

# Funnel decision logging (browser + SSR).
# NEXT_PUBLIC_ENTRY_FUNNEL_DEBUG=1

# Contest enrollment CTAs on hub/score are archived by default.
# Set true to restore Officially Enter / signup flows in the UI.
# NEXT_PUBLIC_CONTEST_ENTRY_UX_ENABLED=true

# --- Analytics ---
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_META_PIXEL_ID=

# --- Site ---
# NEXT_PUBLIC_SITE_URL=https://www.theagnesprotocol.com
# DEEPQUILL_URL=
